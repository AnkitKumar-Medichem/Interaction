rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidQueryLog(data) {
      return data.primaryCompound is string && data.primaryCompound.size() > 0 && data.primaryCompound.size() <= 2000 &&
             data.timestamp is string;
    }

    function isValidLogbook(data) {
      return data.csvContent is string;
    }

    match /query_logs/{logId} {
      allow read: if true;
      allow create: if isValidQueryLog(request.resource.data);
      allow update: if isValidQueryLog(request.resource.data);
      allow delete: if true;
    }

    match /logbook/{docId} {
      allow read: if true;
      allow create, update: if isValidLogbook(request.resource.data);
      allow delete: if true;
    }

    // Allow purging of legacy collections
    match /compounds/{compoundId} {
      allow read, write, delete: if true;
    }

    match /predictions/{predictionId} {
      allow read, write, delete: if true;
    }
  }
}
